import os
from building import *

cwd = GetCurrentDir()

# Main application sources
src = Glob('*.c')

# Font sources from clawdmeter_assets directory
src += Glob('clawdmeter_assets/*.c')

# Include paths
CPPPATH = [cwd, os.path.join(cwd, 'clawdmeter_assets')]

# cJSON include path (external package in SiFli SDK)
sdk_root = os.path.normpath(os.path.join(cwd, '..', '..', '..', 'sifli-sdk'))
cjson_path = os.path.join(sdk_root, 'external', 'cJSON-1.7.17')
if os.path.exists(cjson_path):
    CPPPATH.append(cjson_path)

group = DefineGroup('Applications', src, depend=[''], CPPPATH=CPPPATH)

Return('group')
